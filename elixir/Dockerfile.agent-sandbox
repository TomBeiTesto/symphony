FROM node:22-slim

# Install essential system tools and build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    ca-certificates \
    jq \
    build-essential \
    openssh-client \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# ── Python 3 + pip ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ── Elixir + Erlang (Debian bookworm default packages) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
    erlang \
    elixir \
    && mix local.hex --force && mix local.rebar --force \
    && rm -rf /var/lib/apt/lists/*

# ── Go ──
RUN GOVERSION=1.22.5 \
    && curl -fsSL "https://go.dev/dl/go${GOVERSION}.linux-amd64.tar.gz" | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"

# ── Common Node.js tools (pre-installed globally) ──
RUN npm install -g \
    typescript \
    ts-node \
    jest \
    eslint \
    prettier \
    @anthropic-ai/claude-code

# ── Common Python tools ──
RUN pip3 install --break-system-packages \
    pytest \
    ruff \
    mypy \
    black

# Create non-root user for agent execution
RUN useradd -m -s /bin/bash agent
USER agent

# Workspace is the only writable mount point
WORKDIR /workspace

# Default entrypoint — caller overrides args
ENTRYPOINT ["claude"]
