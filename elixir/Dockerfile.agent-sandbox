FROM node:22-slim

# Install essential system tools, build dependencies, Python 3, and Erlang/Elixir
# in a single layer to minimise image size
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    ca-certificates \
    jq \
    build-essential \
    openssh-client \
    unzip \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    erlang \
    elixir \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && mix local.hex --force && mix local.rebar --force \
    && rm -rf /var/lib/apt/lists/*

# ── Go (with checksum verification) ──
RUN set -eux; \
    GOVERSION=1.22.5; \
    GOARCHIVE="go${GOVERSION}.linux-amd64.tar.gz"; \
    curl -fsSL "https://go.dev/dl/${GOARCHIVE}" -o "/tmp/${GOARCHIVE}"; \
    EXPECTED_SHA256=$(curl -fsSL "https://dl.google.com/go/${GOARCHIVE}.sha256"); \
    echo "${EXPECTED_SHA256}  /tmp/${GOARCHIVE}" | sha256sum -c -; \
    tar -C /usr/local -xzf "/tmp/${GOARCHIVE}"; \
    rm -f "/tmp/${GOARCHIVE}"
ENV PATH="/usr/local/go/bin:${PATH}"

# ── Common Node.js tools (pinned versions for reproducible builds) ──
RUN npm install -g \
    typescript@5.4.5 \
    ts-node@10.9.2 \
    jest@29.7.0 \
    eslint@8.57.1 \
    prettier@3.3.3 \
    @anthropic-ai/claude-code

# ── Common Python tools (pinned versions, user-level to avoid breaking system packages) ──
RUN pip3 install --user \
    pytest==8.3.2 \
    ruff==0.5.7 \
    mypy==1.11.1 \
    black==24.8.0

# Create non-root user for agent execution
RUN useradd -m -s /bin/bash agent
USER agent

# Workspace is the only writable mount point
WORKDIR /workspace

# Default entrypoint — caller overrides args
ENTRYPOINT ["claude"]
